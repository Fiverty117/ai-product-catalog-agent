<!doctype html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <title>{{ branding.display_name }} - {{ title }}</title>
    <style>
      @page { size: {{ page_size }} {{ orientation }}; margin: 12mm; }
      {{ stylesheet | safe }}
    </style>
  </head>
  <body class="layout {{ layout.css_class }} {{ theme.css_class }}" style="--brand-primary: {{ theme.primary_color }}; --brand-accent: {{ theme.accent_color }}; --primary-contrast: {{ theme.primary_contrast_color }}; --accent-contrast: {{ theme.accent_contrast_color }};">
    {% if cover and cover.enabled %}
    {% set has_cover_logo = cover.show_publisher_logo and branding.logo_data_uri %}
    {% set editorial_logo_media = cover.cover_key == "editorial" and has_cover_logo and not cover_hero_data_uri %}
    <section class="catalog-cover cover-{{ cover.cover_key }}{% if cover_hero_data_uri %} cover-has-hero{% elif has_cover_logo %} cover-has-logo{% else %} cover-text-only{% endif %}{% if cover.title|length > 50 %} cover-title-long{% endif %}" aria-label="Catalog cover">
      <div class="cover-content">
        <div class="cover-brand">
          {% if has_cover_logo and not editorial_logo_media %}
          <img class="cover-logo" src="{{ branding.logo_data_uri }}" alt="{{ branding.display_name }}">
          {% endif %}
          <p class="cover-publisher">{{ branding.display_name }}</p>
        </div>
        <div class="cover-headline">
          {% if cover.edition_label %}<p class="cover-edition">{{ cover.edition_label }}</p>{% endif %}
          <h1 class="cover-title">{{ cover.title }}</h1>
          {% if cover.subtitle %}<p class="cover-subtitle">{{ cover.subtitle }}</p>{% endif %}
          <div class="cover-accent" aria-hidden="true"></div>
        </div>
      </div>
      {% if cover_hero_data_uri %}
      <div class="cover-hero"><img src="{{ cover_hero_data_uri }}" alt=""></div>
      {% elif editorial_logo_media %}
      <div class="cover-logo-media"><img src="{{ branding.logo_data_uri }}" alt="{{ branding.display_name }}"></div>
      {% endif %}
    </section>
    {% endif %}
    <header class="catalog-header">
      <div>
        {% if branding.logo_data_uri %}
        <img class="publisher-logo" src="{{ branding.logo_data_uri }}" alt="{{ branding.display_name }}">
        {% else %}
        <p class="store-name">{{ branding.display_name }}</p>
        {% endif %}
        <h1>{{ title }}</h1>
        {% if branding.contact_text or branding.social_handle %}
        <p class="publisher-details">{% if branding.contact_text %}{{ branding.contact_text }}{% endif %}{% if branding.contact_text and branding.social_handle %} · {% endif %}{% if branding.social_handle %}{{ branding.social_handle }}{% endif %}</p>
        {% endif %}
      </div>
      <dl class="catalog-meta">
        <div><dt>Fecha</dt><dd>{{ as_of_label }}</dd></div>
        <div><dt>Moneda</dt><dd>{{ currency }}</dd></div>
      </dl>
    </header>

    <main style="--products-per-row: {{ layout.products_per_row }}">
      {% for section in sections %}
      <section class="category-section">
        <h2 class="category-title">{{ section.category_name }}</h2>
        <div class="product-rows">
          {% for product_row in section.products | batch(layout.products_per_row) %}
          <div class="product-row">
            {% for product in product_row %}
            <article class="product-card">
              <div class="product-image-frame">
                <img src="{{ product.image_data_uri }}" alt="{{ product.product_name }}">
              </div>
              <div class="product-content">
                <p class="product-brand">{{ product.brand_name }}</p>
                <h3>{{ product.product_name }}</h3>
                {% if product.short_description and layout.key != "compact" %}
                <p class="product-description">{{ product.short_description }}</p>
                {% endif %}
                <ul class="variant-list">
                  {% for variant in product.variants %}
                  <li class="variant-row{% if not variant.label %} variant-row--price-only{% endif %}">
                    {% if variant.label %}<span class="variant-label">{{ variant.label }}</span>{% endif %}
                    <strong class="variant-price">{{ variant.price_display }}</strong>
                  </li>
                  {% endfor %}
                </ul>
              </div>
            </article>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </main>

    {% if closing and closing.enabled %}
    {% set closing_labels = {"publisher_contact": "Contacto", "publisher_social": "Red social", "whatsapp": "WhatsApp", "phone": "Teléfono", "instagram": "Instagram", "website": "Sitio web", "address": "Dirección"} %}
    {% set closing_qr_labels = {"whatsapp": "WhatsApp", "website": "Sitio web", "custom_url": "Enlace"} %}
    {% set has_closing_logo = closing.show_publisher_logo and branding.logo_data_uri %}
    {% set closing_density = namespace(contact_characters=0) %}
    {% for contact in closing.contacts %}{% set closing_density.contact_characters = closing_density.contact_characters + contact.value|length %}{% endfor %}
    <section class="catalog-closing closing-{{ closing.closing_key }} {{ 'closing--with-qr' if closing_qr_data_uri else 'closing--without-qr' }} {{ 'closing--single-contact' if closing.contacts|length == 1 else 'closing--multiple-contacts' if closing.contacts|length > 1 else 'closing--no-contacts' }} {{ 'closing--with-logo' if has_closing_logo else 'closing--without-logo' }}{% if (closing.heading or '')|length > 60 or (closing.note or '')|length > 180 or closing.contacts|length >= 5 or closing_density.contact_characters > 360 %} closing-dense{% endif %}" aria-label="Catalog closing page">
      <div class="closing-brand">
        {% if has_closing_logo %}
        <img class="closing-logo" src="{{ branding.logo_data_uri }}" alt="{{ branding.display_name }}">
        {% endif %}
        <p class="closing-publisher">{{ branding.display_name }}</p>
      </div>
      <div class="closing-content">
        {% if closing.heading %}<h1 class="closing-heading">{{ closing.heading }}</h1>{% endif %}
        <div class="closing-accent" aria-hidden="true"></div>
        <div class="closing-details">
          {% if closing.contacts %}
          <dl class="closing-contacts">
            {% for contact in closing.contacts %}
            <div class="closing-contact-item closing-contact-{{ contact.kind }}">
              <dt class="closing-contact-label">{{ closing_labels[contact.kind] }}</dt>
              <dd class="closing-contact-value">{% if contact.href %}<a href="{{ contact.href }}">{{ contact.value }}</a>{% else %}{{ contact.value }}{% endif %}</dd>
            </div>
            {% endfor %}
          </dl>
          {% endif %}
          {% if closing_qr_data_uri %}
          <div class="closing-qr"><img src="{{ closing_qr_data_uri }}" alt="QR"><span class="closing-qr-label">{{ closing_qr_labels[closing.qr_target_type] }}</span>{% if closing.qr_target_type == "custom_url" %}<p>{{ closing.qr_target_url }}</p>{% endif %}</div>
          {% endif %}
        </div>
        {% if closing.note %}<p class="closing-note">{{ closing.note }}</p>{% endif %}
      </div>
    </section>
    {% endif %}
  </body>
</html>
